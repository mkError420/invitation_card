# Database Configuration
# Supported drivers: sqlite, mysql
DB_CONNECTION=sqlite

# SQLite Configuration (Used when DB_CONNECTION=sqlite)
DB_DATABASE=database.sqlite

# MySQL Configuration (Used when DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invitation_db
DB_USERNAME=root
DB_PASSWORD=

# App Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

